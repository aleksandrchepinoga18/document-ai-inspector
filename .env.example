# Copy to .env; Docker Compose reads it automatically. Do not commit .env.
APP_NAME=Document AI Inspector
PROCESSING_TIMEOUT_SECONDS=120
# Stage 2 limits. DATA_DIR is fixed to /app/results by Compose.
MAX_UPLOAD_BYTES=20971520
MAX_ZIP_ENTRIES=1000
MAX_UNCOMPRESSED_BYTES=104857600
MAX_ZIP_RATIO=200
# Stage 3: PDF conversion also stays within PROCESSING_TIMEOUT_SECONDS.
RENDER_TIMEOUT_SECONDS=60
MAX_PDF_BYTES=52428800
MAX_PDF_PAGES=300
# Stage 4: calls happen ONLY with use_llm=true and an explicitly selected provider.
# Choose the name of an installed LOCAL model; cloud model aliases are not allowed.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=
OLLAMA_API_KEY=
# Optional, existing self-hosted vLLM. No GPU deployment is required or performed.
VLLM_BASE_URL=http://host.docker.internal:8001/v1
VLLM_MODEL=
VLLM_API_KEY=
# Yandex requires per-request allow_cloud=true AND synthetic_data=true.
# Keep keys only in .env; do not print docker compose config or commit credentials.
YANDEX_BASE_URL=https://ai.api.cloud.yandex.net/v1
YANDEX_FOLDER_ID=
# Full URI from your catalog; {folder_id} is replaced with YANDEX_FOLDER_ID.
YANDEX_MODEL=
YANDEX_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_TOTAL_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=0
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1024
LLM_MAX_INPUT_CHARS=20000
LLM_MAX_FRAGMENTS=200
LLM_MAX_RESPONSE_CHARS=50000
LLM_JSON_MODE=true
