# Copy to .env; Docker Compose reads it automatically. Do not commit .env.
APP_NAME=Document AI Inspector
PROCESSING_TIMEOUT_SECONDS=120
# Stage 2 limits. DATA_DIR is fixed to /app/results by Compose.
MAX_UPLOAD_BYTES=20971520
MAX_ZIP_ENTRIES=1000
MAX_UNCOMPRESSED_BYTES=104857600
MAX_ZIP_RATIO=200
# Ollama runs on the Windows host. No LLM calls are made in stages 1-2.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=
